# SK-D840N USB WiFi stack — append to openwrt/.config BEFORE `make defconfig`
# in scripts/configure-sk-d840n.sh (put it beside the other CONFIG_PACKAGE_* lines).
#
# Driver: mainline rtl8xxxu claims RTL8188ETV (USB id 0bda:0179). In this branch
# package/kernel/mac80211/realtek.mk has `config-y += RTL8XXXU_UNTESTED`, so the
# 8188EU-family device is included without any extra kernel-symbol edit.
CONFIG_PACKAGE_kmod-rtl8xxxu=y

# Firmware: rtl8188eufw.bin -> /lib/firmware/rtlwifi/
CONFIG_PACKAGE_rtl8188eu-firmware=y

# Userspace for STA mode: wpa_supplicant, regdb, iw
CONFIG_PACKAGE_wpad-basic-mbedtls=y
CONFIG_PACKAGE_wireless-regdb=y
CONFIG_PACKAGE_iw=y
